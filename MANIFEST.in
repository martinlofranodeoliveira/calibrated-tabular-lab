include LICENSE README.md README.pt-BR.md THIRD_PARTY_NOTICES.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include requirements.lock requirements-runtime.lock Dockerfile Dockerfile.prepare Dockerfile.consumer
include .editorconfig .gitignore .dockerignore .github/workflows/ci.yml
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include third_party/licenses *
